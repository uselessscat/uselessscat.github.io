---
import { type Lang } from "../../i18n/ui";
import { getLocalePath, toLang, useTranslations } from "../../i18n/utils";

interface Props {
  title: string;
  eyebrow?: string;
  lang?: Lang;
}

const { title, eyebrow = "// IV DEVS", lang: langProp } = Astro.props;
const lang: Lang = langProp ?? toLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeHref = getLocalePath(lang, "/#inicio");
---

<main
  id="contenido"
  class="mx-auto w-full max-w-7xl flex-1 px-5 pb-14 pt-12 sm:px-8 sm:pt-16"
>
  <p class="font-display text-xs tracking-wider text-ember-400 light:text-ember-300">
    {eyebrow}
  </p>
  <h1 class="mt-3 font-display text-2xl leading-tight text-cream sm:text-3xl md:text-4xl">
    {title}
  </h1>

  <div class="mt-6 flex items-center gap-1.5" aria-hidden="true">
    <span class="h-px flex-1 bg-linear-to-r from-ember-600/80 via-night-500/70 to-transparent"></span>
    <span class="size-1.5 bg-ember-500/80"></span>
  </div>

  <div class="prose-pixel mt-8">
    <slot />
  </div>

  <div class="mt-12">
    <a class="pixel-btn" href={homeHref}>
      ← {t("contentPage.backHome")}
    </a>
  </div>
</main>
