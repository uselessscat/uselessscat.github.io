---
import "./Sky.css";
---

<div class="sky" aria-hidden="true">
  <div class="sky__nebula"></div>
  <div class="sky__stars sky__stars--a"></div>
  <div class="sky__stars sky__stars--b"></div>
  <span class="sky__flare sky__flare--1"></span>
  <span class="sky__flare sky__flare--2"></span>
  <span class="sky__flare sky__flare--3"></span>
  <div class="sky__day"></div>
  <div class="sky__grain"></div>
  <div class="sky__vignette sky__vignette--night"></div>
  <div class="sky__vignette sky__vignette--day"></div>
</div>
