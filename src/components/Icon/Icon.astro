---
import { iconMap, type IconName } from "./icons";

interface Props {
  /** Lucide icon to render. */
  name?: IconName;
  /** Utility classes for size and color. */
  class?: string;
  /** Stroke width. Lucide defaults to 2. */
  strokeWidth?: number;
  /** Accessible label. If omitted, the icon is decorative. */
  label?: string;
}

const {
  name = "diamond",
  class: className = "",
  strokeWidth,
  label,
} = Astro.props;

const IconComponent = iconMap[name] ?? iconMap.diamond;

// With `label` the icon is exposed as an image with an accessible name;
// without it, it stays hidden from screen readers.
const a11y = label
  ? { role: "img" as const, "aria-label": label }
  : { "aria-hidden": "true" as const };
---

<IconComponent
  class={className}
  stroke-width={strokeWidth}
  focusable="false"
  {...a11y}
/>
