---
import Icon from "../Icon/Icon.astro";
import type { Lang } from "../../i18n/ui";
import { toLang, useTranslations } from "../../i18n/utils";
import "./ThemeToggle.css";

interface Props {
  /** Additional utility classes for the button. */
  class?: string;
  /** Language of the accessible texts. Defaults to detection from Astro. */
  lang?: Lang;
}

const { class: className = "", lang: langProp } = Astro.props;
const lang: Lang = langProp ?? toLang(Astro.currentLocale);
const t = useTranslations(lang);

const switchToLight = t("themeToggle.switchToLight");
const switchToDark = t("themeToggle.switchToDark");
---

<button
  type="button"
  class:list={["theme-toggle", className]}
  data-theme-toggle
  role="switch"
  aria-checked="false"
  data-label-light={switchToLight}
  data-label-dark={switchToDark}
  aria-label={switchToLight}
  title={switchToLight}
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__star theme-toggle__star--1"></span>
    <span class="theme-toggle__star theme-toggle__star--2"></span>
    <span class="theme-toggle__star theme-toggle__star--3"></span>
    <span class="theme-toggle__cloud">
      <Icon name="cloud" />
    </span>
    <span class="theme-toggle__thumb">
      <span class="theme-toggle__icon theme-toggle__moon">
        <Icon name="moon" />
      </span>
      <span class="theme-toggle__icon theme-toggle__sun">
        <Icon name="sun" />
      </span>
    </span>
  </span>
</button>

<script>
  const STORAGE_KEY = "ivdevs-theme";
  const root = document.documentElement;

  if (root.dataset.themeReady !== "true") {
    root.dataset.themeReady = "true";

    const getButtons = () =>
      Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]"),
      );
    const colorSchemeQuery = window.matchMedia("(prefers-color-scheme: light)");
    const getThemeColor = () =>
      document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

    const storedTheme = (): "dark" | "light" | null => {
      try {
        const value = localStorage.getItem(STORAGE_KEY);
        return value === "dark" || value === "light" ? value : null;
      } catch {
        return null;
      }
    };

    const currentTheme = (): "dark" | "light" =>
      root.dataset.theme === "light" ? "light" : "dark";

    const labelFor = (
      button: HTMLButtonElement,
      theme: "dark" | "light",
    ): string | undefined => {
      // Labels are rendered from i18n into the data attributes.
      if (theme === "dark") return button.dataset.labelLight;
      return button.dataset.labelDark;
    };

    const labels = (theme: "dark" | "light") => {
      getButtons().forEach((button) => {
        const text = labelFor(button, theme);
        if (text) {
          button.setAttribute("aria-label", text);
          button.setAttribute("title", text);
        }
        button.setAttribute(
          "aria-checked",
          theme === "light" ? "true" : "false",
        );
        button.dataset.currentTheme = theme;
      });
    };

    const apply = (theme: "dark" | "light", persist: boolean) => {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;

      getThemeColor()?.setAttribute(
        "content",
        theme === "light" ? "#F7F5F0" : "#08060f",
      );

      labels(theme);

      if (persist) {
        try {
          localStorage.setItem(STORAGE_KEY, theme);
        } catch {
          /* The theme keeps working even if the browser blocks storage. */
        }
      }
    };

    apply(currentTheme(), false);

    let viewTransitionVersion = 0;
    let pendingTheme: { theme: "dark" | "light"; persist: boolean } | undefined;

    const announceTheme = (theme: "dark" | "light", animate: boolean) => {
      window.dispatchEvent(
        new CustomEvent("ivdevs:themechange", {
          detail: { theme, animate },
        }),
      );
    };

    const applyAnimated = (theme: "dark" | "light", persist: boolean) => {
      // Android Edge can crash when full-page captures are restarted too quickly.
      // Keep only the latest request and run it after the active reveal finishes.
      if (document.activeViewTransition) {
        pendingTheme = { theme, persist };
        return;
      }

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (reduceMotion || typeof document.startViewTransition !== "function") {
        apply(theme, persist);
        announceTheme(theme, false);
        return;
      }

      const button = getButtons()[0];
      const rect = button.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );
      const version = ++viewTransitionVersion;

      root.classList.add("theme-view-transition");

      try {
        const transition = document.startViewTransition(() => {
          apply(theme, persist);
          announceTheme(theme, true);
        });

        void transition.ready
          .then(() => {
            document.documentElement.animate(
              {
                clipPath: [
                  `circle(0px at ${x}px ${y}px)`,
                  `circle(${radius}px at ${x}px ${y}px)`,
                ],
              },
              {
                duration: 500,
                easing: "cubic-bezier(0.4, 0, 0.2, 1)",
                pseudoElement: "::view-transition-new(root)",
              },
            );
          })
          .catch(() => {
            // The capture can be skipped before its pseudo-elements exist.
          });

        void transition.finished.finally(() => {
          if (version !== viewTransitionVersion) return;

          root.classList.remove("theme-view-transition");
          if (pendingTheme) window.requestAnimationFrame(flushPendingTheme);
        });
        return;
      } catch {
        root.classList.remove("theme-view-transition");
        apply(theme, persist);
        announceTheme(theme, false);
      }
    };

    const flushPendingTheme = () => {
      if (document.activeViewTransition) {
        window.requestAnimationFrame(flushPendingTheme);
        return;
      }

      const next = pendingTheme;
      pendingTheme = undefined;
      if (next && next.theme !== currentTheme()) {
        applyAnimated(next.theme, next.persist);
      }
    };

    const bindButtons = () => {
      getButtons().forEach((button) => {
        if (button.dataset.themeToggleBound === "true") return;
        button.dataset.themeToggleBound = "true";
        button.addEventListener("click", () => {
          applyAnimated(currentTheme() === "light" ? "dark" : "light", true);
        });
      });
    };

    bindButtons();
    document.addEventListener("astro:page-load", () => {
      apply(currentTheme(), false);
      bindButtons();
    });

    // ClientRouter replaces the root attributes with the server-rendered ones,
    // which always say "dark". Carry the active theme over before the swap.
    document.addEventListener("astro:before-swap", (event) => {
      const { newDocument } = event as Event & { newDocument: Document };
      const theme = currentTheme();

      newDocument.documentElement.dataset.theme = theme;
      newDocument.documentElement.style.colorScheme = theme;
      newDocument
        .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
        ?.setAttribute("content", theme === "light" ? "#F7F5F0" : "#08060f");
    });

    // Only follow the system if the user has not chosen manually yet.
    colorSchemeQuery.addEventListener("change", (event) => {
      if (storedTheme() === null)
        applyAnimated(event.matches ? "light" : "dark", false);
    });

    window.addEventListener("storage", (event) => {
      if (event.key !== STORAGE_KEY) return;
      if (event.newValue === "dark" || event.newValue === "light") {
        applyAnimated(event.newValue, false);
      }
    });
  }
</script>
