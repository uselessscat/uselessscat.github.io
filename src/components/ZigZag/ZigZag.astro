---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "text-ember-400 drop-shadow-[0_0_10px_rgba(229,113,76,0.25)]",
    className,
  ]}
  aria-hidden="true"
>
  <div class="zigzag w-full bg-current"></div>
</div>

<style>
  .zigzag {
    --zigzag-angle: 90deg;
    --zigzag-size: 30px;
    --zigzag-thickness: 10px;
    --zigzag-image: conic-gradient(
      from calc(var(--zigzag-angle) / -2) at bottom,
      #0000,
      #000 1deg calc(var(--zigzag-angle) - 1deg),
      #0000 var(--zigzag-angle)
    );

    height: calc(
      var(--zigzag-thickness) + var(--zigzag-size) /
        (2 * tan(var(--zigzag-angle) / 2))
    );

    -webkit-mask-image: var(--zigzag-image), var(--zigzag-image);
    -webkit-mask-size: var(--zigzag-size) 100%;
    -webkit-mask-repeat: repeat-x;
    -webkit-mask-position:
      50% calc(-1 * var(--zigzag-thickness)),
      50% 0;
    -webkit-mask-composite: xor;

    mask-image: var(--zigzag-image), var(--zigzag-image);
    mask-size: var(--zigzag-size) 100%;
    mask-repeat: repeat-x;
    mask-position:
      50% calc(-1 * var(--zigzag-thickness)),
      50% 0;
    mask-composite: exclude;
  }
</style>
