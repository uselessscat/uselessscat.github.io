---
import Card from "../Card/Card.astro";
import SocialIcon from "./SocialIcon.astro";
import { socialIcons, type SocialIconName } from "./icons";

const icons = Object.keys(socialIcons) as SocialIconName[];
---

<div class="mx-auto grid w-full max-w-3xl grid-cols-3 gap-4 p-8 sm:grid-cols-4">
  {icons.map((name) => (
    <Card
      variant="dim"
      padding="md"
      innerClass="flex flex-col items-center gap-3"
    >
      <div class="grid aspect-square w-full max-w-14 place-items-center rounded-sm bg-white p-2">
        <SocialIcon name={name} class="size-7" />
      </div>
      <span class="font-display text-xs tracking-wider text-cream/80">
        {name}
      </span>
    </Card>
  ))}
</div>
