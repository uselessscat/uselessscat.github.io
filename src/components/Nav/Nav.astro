---
import {
  getHomeHref,
  getNavLinks,
  isNavLinkActive,
  type NavLink,
} from "../../data/nav";
import type { Lang } from "../../i18n/ui";
import { toLang, useTranslations } from "../../i18n/utils";
import LangPicker from "../LangPicker/LangPicker.astro";
import ThemeToggle from "../ThemeToggle/ThemeToggle.astro";
import "./Nav.css";

interface Props {
  /** Path used to mark the active link. Defaults to the current path. */
  currentPath?: string;
  /** Active language. Detected from Astro by default. */
  lang?: Lang;
}

const { currentPath: currentPathProp, lang: langProp } = Astro.props;

const lang: Lang = langProp ?? toLang(Astro.currentLocale);

const t = useTranslations(lang);
const navLinks = getNavLinks(lang);
const homeHref = getHomeHref(lang);
const currentPathname = currentPathProp ?? Astro.url?.pathname ?? "/";

const isActive = (link: NavLink) =>
  isNavLinkActive(link, currentPathname, lang);
---

<header class="iv-nav sticky top-0 z-40">
  <div class="border-b border-line bg-night-950/70 backdrop-blur-md">
    <nav
      class="mx-auto grid max-w-7xl grid-cols-[1fr_auto] items-center gap-x-0 px-5 py-3.5 min-[360px]:gap-x-2 lg:grid-cols-[1fr_auto_1fr] lg:gap-x-6"
      aria-label={t("nav.label")}
    >
      <a
        href={homeHref}
        class="nav-brand justify-self-start font-arcade text-[0.5rem] text-cream min-[360px]:text-[0.6875rem] sm:text-sm lg:text-base xl:text-lg"
        aria-label={t("nav.homeAria")}
      >
        &lt;<span class="text-ember-500">IV</span>&nbsp;DEVS/&gt;
      </a>

      <ul class="hidden items-center justify-center gap-8 lg:flex lg:gap-6 lg:text-sm xl:gap-11 xl:text-base">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "nav-link text-base text-cream/80 transition-colors hover:text-gold-text-strong lg:text-sm xl:text-base",
                isActive(link) && "text-gold-text-strong",
              ]}
              aria-current={isActive(link) ? "page" : undefined}
            >
              {`/ ${link.label}`}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center justify-end gap-1 justify-self-end min-[360px]:gap-2">
        <LangPicker lang={lang} currentPathname={currentPathname} />
        <ThemeToggle lang={lang} />

        <button
          type="button"
          class="pixel-tile lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
          data-menu-label-open={t("nav.openMenu")}
          data-menu-label-close={t("nav.closeMenu")}
        >
          <span class="sr-only">{t("nav.openMenu")}</span>
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="border-t border-line bg-night-900/95 backdrop-blur-md lg:hidden"
      data-menu
      hidden
    >
      <ul class="mx-auto max-w-7xl px-5 py-2">
        {navLinks.map((link) => (
          <li class="border-b border-line last:border-0">
            <a
              href={link.href}
              class="block py-2.5 text-cream/85 transition-colors hover:text-gold-text-strong"
            >
              {`<${link.label}/>`}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  let navAbort: AbortController | undefined;

  const initNav = () => {
    navAbort?.abort();
    navAbort = new AbortController();
    const { signal } = navAbort;

    const toggle =
      document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    if (!toggle || !menu) return;

    const label = toggle.querySelector(".sr-only");

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
      if (label) {
        // Labels are rendered from i18n into the data attributes.
        const nextLabel = open
          ? toggle.dataset.menuLabelClose
          : toggle.dataset.menuLabelOpen;
        if (nextLabel) label.textContent = nextLabel;
      }
    };

    toggle.addEventListener(
      "click",
      () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      },
      { signal },
    );

    menu.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a"))
          setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") setOpen(false);
      },
      { signal },
    );

    window.addEventListener(
      "resize",
      () => {
        if (window.matchMedia("(min-width: 1024px)").matches) setOpen(false);
      },
      { signal },
    );
  };

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
