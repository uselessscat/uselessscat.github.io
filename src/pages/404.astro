---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav/Nav.astro";
import ContentPage from "../components/ContentPage/ContentPage.astro";
import Footer from "../components/Footer/Footer.astro";
import { getSite } from "../data/site";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
const site = getSite(lang);
---

<Layout
  lang={lang}
  title={`${t("notFound.title")} — IV Devs`}
  description={t("notFound.description")}
>
  <Nav lang={lang} />

  <ContentPage
    lang={lang}
    title={t("notFound.title")}
    eyebrow={t("notFound.eyebrow")}
  >
    <p>{t("notFound.intro")}</p>

    <pre class="theme-dark mt-6 overflow-x-auto border border-line bg-night-900/80 p-4 font-pixel text-sm leading-relaxed text-ember-300"><code>~$ curl -I ivdevs.cl/esta-pagina
HTTP/2 404
x-region: coquimbo
x-status: {t("notFound.codeStatus")}</code></pre>

    <p>
      {t("notFound.outroLead")}
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </ContentPage>

  <Footer lang={lang} />
</Layout>
